<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvPatientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Patient Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvExaminationId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exam ID"
                android:textSize="10sp"
                android:textColor="@color/grey"
                android:background="@color/light_gray"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

        <!-- Doctor Info -->
        <TextView
            android:id="@+id/tvDoctorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Doctor: Dr. Smith"
            android:textSize="14sp"
            android:textColor="@color/primary_dark"
            android:layout_marginBottom="4dp" />

        <!-- Completion Time -->
        <TextView
            android:id="@+id/tvCompletionTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completed: Jan 01, 2024 at 10:30 AM"
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:layout_marginBottom="12dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnNotifyPatient"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Notify"
                android:textSize="12sp"
                android:backgroundTint="@color/green"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/btnViewDetails"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Details"
                android:textSize="12sp"
                android:backgroundTint="@color/blue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnContactPatient"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Contact"
                android:textSize="12sp"
                android:backgroundTint="@color/orange"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>