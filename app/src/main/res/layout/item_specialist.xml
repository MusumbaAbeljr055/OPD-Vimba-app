<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Specialist Photo -->
        <ImageView
            android:id="@+id/specialistImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/health"
            android:contentDescription="Specialist Photo"
            android:background="@drawable/circle_bg"
            android:padding="4dp" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/specialistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. John Doe"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/specialistSpecialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiologist"
                android:textSize="14sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/specialistAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Today"
                android:textSize="12sp"
                android:textColor="@color/blue"/>
        </LinearLayout>

        <!-- Rating -->
        <TextView
            android:id="@+id/specialistRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.5 ★"
            android:textSize="16sp"
            android:textColor="@color/my_primary"
            android:paddingStart="8dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
