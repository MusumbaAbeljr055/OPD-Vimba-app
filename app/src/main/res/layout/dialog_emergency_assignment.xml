<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Emergency Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/emergency_red"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨"
            android:textSize="20sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EMERGENCY CASE"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Patient Information -->
    <TextView
        android:id="@+id/tvPatientInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patient: Loading..."
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Emergency Details -->
    <TextView
        android:id="@+id/tvEmergencyDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emergency Details: Loading..."
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_marginBottom="16dp" />

    <!-- Doctor Selection Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Emergency Doctor:"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Doctor Spinner with Progress -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <Spinner
            android:id="@+id/spinnerEmergencyDoctors"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <ProgressBar
            android:id="@+id/progressBarDoctors"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- Available Doctors Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Emergency doctors are from Emergency Department or General Medicine"
        android:textColor="@color/my_primary"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- View Details Button -->
        <Button
            android:id="@+id/btnViewDetails"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="View Details"
            android:textColor="@android:color/black"
            android:background="@drawable/button_outline_background"
            android:textSize="14sp"
            android:textStyle="normal" />

        <!-- Assign Immediately Button -->
        <Button
            android:id="@+id/btnAssignImmediately"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="ASSIGN NOW"
            android:textColor="@android:color/white"
            android:background="@color/emergency_red"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Emergency Instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Emergency cases require immediate attention. Please assign to available emergency doctor promptly."
        android:textColor="@android:color/black"
        android:textSize="10sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="@android:color/holo_orange_light" />

</LinearLayout>