<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:orientation="vertical">

    <!-- Header with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white"
            android:padding="4dp"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medical Records"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your complete health history and medical documents"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:alpha="0.8"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:tint="@color/white"
            android:padding="4dp"
            android:contentDescription="Search" />
    </LinearLayout>

    <!-- Quick Stats Cards -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:fadingEdgeLength="32dp"
        android:requiresFadingEdge="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Total Records Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="100dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvTotalRecords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/purple_700"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalRecordsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Records"
                        android:textColor="@color/grey"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Vital Metrics Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="100dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvVitalMetricsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/my_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVitalMetricsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vital Records"
                        android:textColor="@color/grey"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Last Updated Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="100dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivLastUpdated"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_update"
                        android:tint="@color/green"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/tvLastUpdatedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Updated"
                        android:textColor="@color/grey"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Download Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="100dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivDownloadStatus"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_baseline_file_download_24"
                        android:tint="@color/blue"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvDownloadedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/blue"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDownloadedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Downloaded"
                        android:textColor="@color/grey"
                        android:textSize="10sp"
                        android:gravity="center" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Emergency Access Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/emergencyAccessCard"
                android:layout_width="140dp"
                android:layout_height="100dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivEmergencyIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_emergency"
                        android:tint="@color/red"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvEmergencyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency\nAccess"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Search Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivSearchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/grey"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search records..."
                android:background="@null"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textColorHint="@color/grey" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close"
                android:tint="@color/grey"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filter Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:fadingEdgeLength="32dp"
        android:requiresFadingEdge="horizontal">

        <LinearLayout
            android:id="@+id/filterLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/filter_selected_background"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="All Records"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filterPrescriptions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/filter_unselected_background"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Prescriptions"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/filterDiagnosis"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/filter_unselected_background"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Diagnosis"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/filterVaccinations"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/filter_unselected_background"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Vaccinations"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/filterLabResults"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/filter_unselected_background"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Lab Results"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/filterVitalMetrics"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/filter_unselected_background"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Vital Metrics"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Medical Records List -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Records List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMedicalRecords"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                android:clipToPadding="false" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="48dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivEmptyState"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:src="@drawable/ic_medical_folder"
                    android:tint="@color/white"
                    android:alpha="0.7"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No Medical Records Found"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvEmptyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your medical history, prescriptions, test results and vital signs will appear here once available"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.8" />

                <Button
                    android:id="@+id/btnRequestRecords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request Records"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_700"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="24dp"
                    android:elevation="4dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Generate Report FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabGenerateReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Generate Report"
        android:src="@drawable/ic_report"
        android:contentDescription="Generate health report"
        app:backgroundTint="@color/purple_700"
        app:tint="@color/white"
        app:iconTint="@color/white" />

</LinearLayout>