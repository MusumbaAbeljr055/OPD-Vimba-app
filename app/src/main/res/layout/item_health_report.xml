<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_baseline_email_24"
            android:tint="@color/red"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReportName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Health Summary Report"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15 Dec 2024"
                android:textColor="@color/grey"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comprehensive Health Analysis"
                android:textColor="@color/grey"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnViewReport"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:background="@drawable/outline_button_background"
            android:text="View"
            android:textColor="@color/purple_700"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>